# ============================================================
# 环境变量配置示例
# 使用方法：
#   1. 复制本文件为 .env（注意文件名前面有个点）
#   2. 填入你的真实 API Key
#   3. .env 已在 .gitignore 中，不会传到 Git
#
#   代码中读取方式：
#     from dotenv import load_dotenv
#     import os
#     load_dotenv()
#     api_key = os.getenv("DEEPSEEK_API_KEY")
# ============================================================

# DeepSeek
DEEPSEEK_API_KEY=你的_DeepSeek_API_Key
BASE_URL=https://api.deepseek.com/


# 应用配置
MODEL=deepseek-flash
TEMPERATURE=0.7
MAX_TOKENS=4096
TIMEOUT = 10.0
REPO = pallets/flask

# 测试接口
GITHUB_API_BASE = https://api.github.com/
BAIDU_API_BASE = https://www.baidu.com